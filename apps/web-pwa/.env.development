# Local development — uses Firebase emulators. No real credentials needed.
VITE_FIREBASE_PROJECT_ID=demo-salt
VITE_USE_EMULATORS=true
# PostHog (browser observability) — EU region. Key provisioned out-of-band; an
# empty key makes the observability adapter a complete no-op (posthog.init is
# never called).
VITE_PUBLIC_POSTHOG_KEY=phc_qw73ZuXRSy6VBhZhVLRqaiNfVEB9kektGLSAGUyLTf5x
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# PWA install identity (issue #141) — local brand: green. (SW is disabled in dev.)
# No re-coloured icon variant here: local is served from vite, never installed to a
# home screen, so it keeps the master icon set. index.html needs the var in every
# mode, hence the explicit unsuffixed path.
VITE_PWA_NAME=Salt (Dev)
VITE_PWA_SHORT_NAME=Salt Dev
VITE_PWA_THEME_COLOR="#16A34A"
VITE_PWA_ICON_PATH=/icons

# VAPID public key for web-push cook-timer notifications (issue #544). Public
# by design (the private key is a CF secret). Per-environment DISTINCT keypair — a
# subscription minted under one project's public key is undeliverable by another's
# private key. Empty disables the notifications toggle. Generate the pair with
# `npx web-push generate-vapid-keys` and set the matching VAPID_PRIVATE_KEY secret
# + VAPID_PUBLIC_KEY env on the Cloud Functions side.
VITE_VAPID_PUBLIC_KEY=
