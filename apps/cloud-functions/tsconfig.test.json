{
  // The unit suite's own typecheck (issue #1135, closing UT-G1 for this app).
  // `tsconfig.json` is the BUILD config — `rootDir: "src"`, `composite`, emits
  // to `dist` — so it can never include `tests/**`; a composite project cannot
  // see files outside its `rootDir`. Wired into the root `typecheck` script,
  // beside `probes/tsconfig.json`, which is the half that matters: a config
  // that merely exists is checked by nothing.
  //
  // `module`/`moduleResolution: NodeNext` are inherited from `./tsconfig.json`
  // and deliberately not restated — the tests resolve specifiers exactly as the
  // functions they exercise do.
  //
  // NOT covered here, both on purpose: `probes/**`, which has its own config
  // already in the root script, and `scripts/**`, which is issue #1118. Adding
  // `scripts/**` to this include would close #1118 by accident and without its
  // fixes.
  //
  // `allowJs` exists for exactly one file: `kitchenToolVocabulary.test.ts` and
  // `pruneInstanceNamedKitchenTools.test.ts` both import
  // `scripts/kitchen-tool-vocabulary.mjs`, which has no declarations. TS reads it
  // and INFERS its exports; `checkJs` stays off, so the `.mjs` itself is still
  // not typechecked — that is #1118's job, and this does not do it. The
  // alternative was a suppression in two test files, which would have hidden the
  // shape rather than recovered it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*", "tests/**/*"]
}
