rules_version = '2';

// Salt Firebase Storage rules.
//
// First real use of Firebase Storage: canon-item icons (Tier-1 pictograms,
// issue #148). Icons are non-sensitive cartoon pictograms generated server-side
// by the onCanonItemWritten Cloud Function (Admin SDK, which bypasses these
// rules). The browser only ever renders them via <img src={publicUrl}>, so the
// client needs public read access but never write access — keeping the web
// client Storage-SDK-free.
service firebase.storage {
  match /b/{bucket}/o {
    // Canon icons: public read so any <img> tag can load them; client writes
    // denied (only the CF Admin SDK writes here).
    match /canon-icons/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Product-form icons (issue #871): the canon-icon pipeline pointed at a second
    // collection, so the same posture — written server-side by onProductFormWritten
    // (Admin SDK, which bypasses these rules), rendered client-side via
    // <img src={publicUrl}>. Public read, no client write. A SEPARATE prefix from
    // `canon-icons/` rather than a shared one, because the weekly orphan sweep
    // joins each prefix against its own owning collection.
    match /product-form-icons/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Recipe hero images (Tier-2, issue #148): same model as canon icons —
    // non-sensitive photos generated server-side by the onRecipeWritten Cloud
    // Function (Admin SDK, which bypasses these rules) and rendered client-side
    // via <img src={publicUrl}>. Public read, no client write.
    match /recipe-images/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Batch observation photos (issue #812, phase 4 of epic #778): a photograph of
    // the crock, the loaf or the mould on the coppa, attached to one entry in a
    // run's observation log. Same model again — written server-side by the
    // setObservationImageUpload callable (Admin SDK, which bypasses these rules)
    // and rendered client-side via <img src={publicUrl}>. Public read, no client
    // write: this feature introduces NO client-writable Storage path.
    //
    // TWO SEGMENTS IN THE MATCH, and this is not decoration. Objects live at
    // `batch-images/{batchId}/{observationId}.webp` — nested because an observation
    // is nested — and a `{file}` wildcard matches exactly ONE path segment, so
    // `match /batch-images/{file}` would never fire on that path: every photo would
    // fall through to the catch-all below and be unreadable.
    //
    // `read: if true` matches the two prefixes above, and is the deliberate choice
    // rather than the unconsidered one. These are the first user-TAKEN photographs
    // in Salt (canon icons and recipe heroes are generated), so the posture is worth
    // a second look — but a Storage download URL is unguessable in practice, the
    // whole app is family-shared, and one prefix reading differently from its
    // neighbours is the kind of inconsistency that gets "tidied" back later. Raised
    // in review rather than diverged from here.
    match /batch-images/{batchId}/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Equipment pictograms (issue #877): the third subject family on the Tier-1
    // pictogram pipeline, and the same model as canon icons — generated
    // server-side by the drawEquipmentIcon callable (Admin SDK, which bypasses
    // these rules) and rendered client-side via <img src={publicUrl}>. Public
    // read, no client write. WITHOUT THIS BLOCK the catch-all below denies
    // everything and the icons are simply unreadable.
    match /equipment-icons/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Everything else: locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
